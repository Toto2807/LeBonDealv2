# Copie ce fichier vers backend/.env puis adapte les valeurs.
# Utilise des mots de passe sans caractères spéciaux (ils sont insérés dans l'URI MongoDB).

# --- API ---
PORT=3000
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum
JWT_EXPIRES_IN=2h

# --- Conteneur MongoDB (lu par docker-compose.yml) ---
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_USER=lebondeal_app
MONGO_APP_PASSWORD=change-me-app
MONGO_APP_DB=lebondeal

MONGODB_URI=mongodb://lebondeal_app:change-me-app@localhost:27017/lebondeal?authSource=admin
MONGODB_URI_TEST=mongodb://lebondeal_app:change-me-app@localhost:27017/lebondeal_test?authSource=admin
